# Copy this file to .env and fill it in. Never commit .env (it is git-ignored). No quotes, no spaces around "=".

# --- Required in production ---
NODE_ENV=production
PORT=3000
# A long random secret. Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Behind Caddy, nginx or a tunnel, set 1 so the app sees each customer's real address (rate limits, secure cookies).
TRUST_PROXY=1
# Your public address, used in QR codes and alert messages. Example: https://menu.yourdomain.com
PUBLIC_URL=

# --- Where things are kept (use a folder that survives restarts and updates) ---
DB_FILE=/opt/explodish/data/explodish.db
BACKUP_DIR=/opt/explodish/backups
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=14

# --- Optional alerts ---
# Telegram: create a bot with @BotFather, paste its token here.
TELEGRAM_BOT_TOKEN=
# Lock-screen notifications: a real contact address (Apple can reject a made-up one).
PUSH_CONTACT=mailto:you@yourdomain.com

# --- Optional tuning ---
# Time zone used for "today" in reports and order numbers.
REPORT_TZ=Asia/Kolkata
# Seconds before a waiting customer is told "a waiter will come".
WAITER_AFTER_SEC=180
